#!/bin/sh

set -e

echo "======================================"
echo " MiniKV - Pre-commit checks"
echo "======================================"

echo "[CHECK] Git whitespace..."
git diff --cached --check

echo "[CHECK] Code formatting..."
make format

echo "[CHECK] Compilation..."
make clean
make

echo "[CHECK] Memory check..."
make memcheck

echo "======================================"
echo " All checks passed!"
echo "======================================"

exit 0
